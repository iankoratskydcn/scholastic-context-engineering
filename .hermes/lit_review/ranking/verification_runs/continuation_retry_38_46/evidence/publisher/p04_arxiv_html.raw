<li class="ltx_tocentry ltx_tocentry_section"><a href="#S10" title="In Computational Extraction of Legal Causes via al-Ṣabr wa al-Taqsim" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">10 </span>Computational Complexity and Tractability</span></a></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S11" title="In Computational Extraction of Legal Causes via al-Ṣabr wa al-Taqsim" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">11 </span>Conclusion</span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In Computational Extraction of Legal Causes via al-Ṣabr wa al-Taqsim" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
</ol></nav>
</nav>
